# Factory Control System — edge (saha sunucusu) ayarları
# Bu dosyayı ".env" olarak kopyalayın. .env dosyası Git'e eklenmez.

# Merkez edge API adresi (Windows'ta "localhost" önce IPv6'ya çözüldüğü için 127.0.0.1 daha hızlıdır)
EDGE_API_URL=http://127.0.0.1:8000/edge/v1

# Edge node API anahtarı (backend klasöründe "python -m app.cli.edge_nodes create ..." ile üretilir)
EDGE_API_KEY=

# Gönderilemeyen olayların saklandığı yerel kuyruk (ağ kopmasına dayanıklılık)
EDGE_OUTBOX_PATH=./data/outbox.db

# Heartbeat / döngü aralığı (saniye)
EDGE_HEARTBEAT_INTERVAL_S=10

# HTTP isteği zaman aşımı (saniye)
EDGE_HTTP_TIMEOUT_S=10
