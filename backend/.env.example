# Factory Control System — backend ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayın. .env dosyası Git'e eklenmez.

# Yalnızca "development" veya "test". Gerçek kimlik doğrulama olmadığı için
# başka bir değerle uygulama başlamayı reddeder.
APP_ENV=development

# Veritabanı bağlantısı (SQLAlchemy URL)
#   SQLite (varsayılan, yerel geliştirme): sqlite:///./data/fcs_dev.db
#   PostgreSQL (ileride):                  postgresql+psycopg://kullanici:sifre@localhost:5432/fcs
DATABASE_URL=sqlite:///./data/fcs_dev.db

# İzin verilen frontend origin'leri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Kabul edilen Host başlıkları (yerel erişim dışını engeller)
ALLOWED_HOSTS=localhost,127.0.0.1

# "Bugün" hesaplamaları için saat dilimi
APP_TIMEZONE=Europe/Istanbul

# SQL sorgularını konsola yazdır (hata ayıklama)
DB_ECHO=false

# --- Edge (saha sunucusu) ---
# Bu süre (sn) boyunca heartbeat gelmeyen kameralar çevrimdışı sayılır
EDGE_HEARTBEAT_TIMEOUT_S=60
# Canlılık kontrolü aralığı (sn); 0 = kapalı
EDGE_LIVENESS_CHECK_INTERVAL_S=15
# Edge saatinin ileride olabileceği en fazla süre (sn)
EDGE_MAX_CLOCK_SKEW_S=300
