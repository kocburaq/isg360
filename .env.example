# Factory Control System - frontend ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayıp düzenleyebilirsiniz (Git'e eklenmez).

# Veri kaynağı:
#   mock - örnek veri, backend gerekmez (varsayılan)
#   api  - FastAPI backend (backend/ klasörü). "http" de kabul edilir.
VITE_DATA_SOURCE=mock

# FastAPI backend temel adresi (VITE_DATA_SOURCE=api olduğunda kullanılır)
VITE_API_BASE_URL=http://localhost:8000/api/v1
