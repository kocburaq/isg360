# Factory Control System - ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayıp düzenleyebilirsiniz.

# Veri kaynağı: "mock" (örnek veri) veya "api" (gelecekteki FastAPI backend)
VITE_DATA_SOURCE=mock

# FastAPI backend temel adresi (VITE_DATA_SOURCE=api olduğunda kullanılır)
VITE_API_BASE_URL=http://localhost:8000/api/v1
